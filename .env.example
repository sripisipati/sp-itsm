# Development-only configuration. Copy to .env at the repository root.
# .env is gitignored. Never commit real credentials.

NODE_ENV=development

# Local PostgreSQL. These credentials are for local development only.
DATABASE_URL=postgresql://itsm:itsm_dev_only@localhost:5432/itsm?schema=public

# Development-only signing key. Production startup rejects this value.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=8h

PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# local writes to STORAGE_DIR. s3 is reserved and fails closed until configured.
STORAGE_DRIVER=local
STORAGE_DIR=../storage
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_ALLOWED_MIME=text/plain,text/csv,application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/json

THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# Display timezone for dates in the UI (stored in UTC).
VITE_TIME_ZONE=UTC
VITE_API_URL=
